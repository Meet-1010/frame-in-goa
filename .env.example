# Only needed for the "Share to X" link preview. Without it, shares are written
# to .data/ on disk, which is fine locally but will not survive on serverless.
# On Vercel: Storage tab -> create a Blob store -> connect it to the project and
# this gets injected automatically.
BLOB_READ_WRITE_TOKEN=

# Set this in production so og:image URLs are absolute. Vercel fills it in on its
# own via VERCEL_PROJECT_PRODUCTION_URL, so this is only for custom domains.
NEXT_PUBLIC_SITE_URL=
